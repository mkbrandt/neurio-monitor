# IP address of the Neurio sensor on your LAN (find it in your router's DHCP client list)
NEURIO_IP=192.168.1.50

# How often to poll the sensor, in milliseconds
POLL_INTERVAL_MS=10000

# Port for the dashboard web server
PORT=3000

# Optional: your electricity rate, used only to show $ figures in the Solar
# Savings card (exported + used-from-solar energy x rate). Leave unset to
# hide dollar figures entirely - they're never estimated without this.
# This is only the *initial* value - it can be changed later from the
# Settings page in the app without restarting the server.
# ELECTRICITY_RATE_USD_PER_KWH=0.15
